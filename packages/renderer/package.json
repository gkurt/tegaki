{
  "name": "tegaki",
  "version": "1.0.1",
  "type": "module",
  "description": "Framework-agnostic animated handwriting renderer with React, Svelte, Vue, Nuxt, SolidJS, Astro, and Web Components adapters",
  "keywords": [
    "handwriting",
    "animation",
    "svg",
    "react",
    "svelte",
    "vue",
    "solid",
    "astro",
    "nuxt",
    "web-components",
    "custom-elements",
    "font",
    "calligraphy",
    "stroke-order",
    "text-animation",
    "writing-animation"
  ],
  "homepage": "https://tegaki.ink/",
  "bugs": {
    "url": "https://github.com/gkurt/tegaki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gkurt/tegaki.git",
    "directory": "packages/renderer"
  },
  "license": "MIT",
  "bin": {
    "tegaki": "./dist/cli.mjs"
  },
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "exports": {
