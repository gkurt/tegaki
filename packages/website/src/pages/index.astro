---
import { Font } from 'astro:assets';
import { Code } from 'astro:components';
import { ChatStream } from '../components/home/ChatStream';
import { ControlledTime } from '../components/home/ControlledTime';
import { Finale } from '../components/home/Finale';
import { Greetings, Hero } from '../components/home/Hero';
import { Scripts } from '../components/home/Scripts';
import { Styles } from '../components/home/Styles';
import { TypeIt } from '../components/home/TypeIt';
import { Write } from '../components/home/Write';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Tegaki — every font, written by hand';
const description =
  'Tegaki turns any font into animated handwriting, drawn stroke by stroke in the order a hand would write it. Eight writing systems; React, Svelte, Vue, SolidJS, Astro, Web Components and vanilla JS.';

const FRAMEWORKS = [
  {
    id: 'react',
    label: 'React',
    lang: 'tsx',
    code: `import { TegakiRenderer } from 'tegaki';
import caveat from 'tegaki/fonts/caveat';

export const Note = () => (
  <TegakiRenderer font={caveat} style={{ fontSize: 56 }}>
    Hello, world!
  </TegakiRenderer>
);`,
  },
  {
    id: 'svelte',
    label: 'Svelte',
    lang: 'svelte',
    code: `<script>
  import { TegakiRenderer } from 'tegaki/svelte';
  import caveat from 'tegaki/fonts/caveat';
</script>

<TegakiRenderer font={caveat} text="Hello, world!"
  style="font-size: 56px" />`,
  },
  {
    id: 'vue',
    label: 'Vue',
    lang: 'vue',
    code: `<script setup>
import { TegakiRenderer } from 'tegaki/vue';
import caveat from 'tegaki/fonts/caveat';
</script>

<template>
  <TegakiRenderer :font="caveat" text="Hello, world!" />
</template>`,
  },
  {
    id: 'solid',
    label: 'Solid',
    lang: 'tsx',
    code: `import { TegakiRenderer } from 'tegaki/solid';
import caveat from 'tegaki/fonts/caveat';

export const Note = () => (
  <TegakiRenderer font={caveat} text="Hello, world!"
    style={{ 'font-size': '56px' }} />
);`,
  },
  {
    id: 'astro',
    label: 'Astro',
    lang: 'astro',
    code: `---
import TegakiRenderer from 'tegaki/astro';
import caveat from 'tegaki/fonts/caveat';
---

<TegakiRenderer font={caveat} text="Hello, world!" />`,
  },
  {
    id: 'wc',
    label: 'Web Component',
    lang: 'html',
    code: `<tegaki-renderer font="Caveat" text="Hello, world!">
</tegaki-renderer>

<script type="module">
  import { registerTegakiElement, TegakiEngine } from 'https://esm.sh/tegaki/wc';
  import caveat from 'https://esm.sh/tegaki/fonts/caveat';
  TegakiEngine.registerBundle(caveat);
  registerTegakiElement();
</script>`,
  },
  {
    id: 'vanilla',
    label: 'Vanilla',
    lang: 'js',
    code: `import { TegakiEngine } from 'tegaki/core';
import caveat from 'tegaki/fonts/caveat';

new TegakiEngine(document.querySelector('#note'), {
  font: caveat,
  text: 'Hello, world!',
});`,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}/tegaki-card.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@gkurttech" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-instrument-serif" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@700&text=%E6%89%8B%E6%9B%B8&display=block" />
    <script is:inline>
      // Share the docs' theme choice (Starlight stores it here; '' follows the system) before first paint.
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="nav">
      <a class="nav-brand" href={`${base}/`} aria-label="Tegaki home">
        <span class="nav-name">Tegaki</span>
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href={`${base}/getting-started/`}>Docs</a>
        <a href={`${base}/studio/`}>Studio</a>
        <a href="https://github.com/gkurt/tegaki" class="nav-icon" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
            ></path></svg
          >
        </a>
        <button type="button" class="nav-icon theme-toggle" aria-label="Toggle dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"
            ></path></svg
          >
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"></circle><path
              d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path></svg
          >
        </button>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow"><span lang="ja">手書き</span> <i>tegaki</i> — Japanese for “handwriting”</p>
        <h1 class="sr-only">Every font, written by hand.</h1>
        <Hero client:load />
        <p class="lede">
          Stroke-by-stroke handwriting animation for any font. Tegaki extracts each glyph's strokes, their order and width, and draws them on a
          canvas over real, selectable text.
        </p>
        <div class="cta">
          <a class="button button-primary" href={`${base}/getting-started/`}>
            Get started
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
              ></path></svg
            >
          </a>
          <a class="button" href={`${base}/studio/`}>Open the Studio</a>
          <button type="button" class="install" data-copy="npm i tegaki" aria-label="Copy install command">
            <span class="install-prompt">$</span> npm i tegaki
            <span class="install-state" aria-live="polite">copy</span>
          </button>
        </div>
        <Greetings client:load />
      </section>

      <section class="chapter" id="time">
        <header class="chapter-head">
          <span class="chapter-num">01</span>
          <h2>Controlled <em>time</em></h2>
          <p>
            Pass a time in seconds, a <code>'50%'</code> progress, or <code>'css'</code> to read it from the <code>--tegaki-progress</code> custom
            property. The renderer seeks to that instant in either direction, so the pen can follow a scroll timeline, a slider, or a video frame.
          </p>
        </header>
        <ControlledTime client:load />
      </section>

      <section class="chapter" id="scripts">
        <header class="chapter-head">
          <span class="chapter-num">02</span>
          <h2>Eight writing <em>systems</em></h2>
          <p>
            Hebrew and Arabic right to left with positional forms, Devanagari and Bengali headlines drawn across the word, and Japanese, Korean
            and Chinese in reference stroke order (KanjiVG, Make Me a Hanzi). Text is shaped with HarfBuzz.
          </p>
        </header>
        <Scripts client:load />
      </section>

      <section class="chapter" id="styles">
        <header class="chapter-head">
          <span class="chapter-num">03</span>
          <h2><em>Effects</em></h2>
          <p>
            Glow, wobble, per-stroke and whole-text gradients, and taper, composed per renderer. Strokes keep the font's own width by default.
          </p>
        </header>
        <Styles client:load />
      </section>

      <section class="chapter" id="write">
        <header class="chapter-head">
          <span class="chapter-num">04</span>
          <h2><em>Editable</em> text</h2>
          <p>
            The canvas draws over real DOM text, so it selects, copies and reads out to screen readers. With <code>editable</code> it takes input:
            each letter you type is written as it arrives.
          </p>
        </header>
        <div class="typeit-wrap">
          <TypeIt client:load />
          <div class="marginalia" aria-hidden="true">
            <Write client:load text="type here" tone="seal" className="marginalia-note" />
            <svg class="marginalia-arrow" viewBox="0 0 120 80"><path d="M104 6c2 26-14 50-44 58-14 4-28 4-42 0M28 52 16 64l14 10"></path></svg>
          </div>
        </div>
      </section>

      <section class="chapter chapter-split" id="stream">
        <header class="chapter-head">
          <span class="chapter-num">05</span>
          <h2><em>Streaming</em> text</h2>
          <p>
            Update <code>text</code> as tokens arrive and the pen continues from where it is. <code>catchUp</code> raises the playback speed while
            the pen is behind the stream.
          </p>
          <Code
            class="code code-inline"
            lang="tsx"
            themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }}
            defaultColor={false}
            code={`<TegakiRenderer
  font={caveat}
  time={{ mode: 'uncontrolled', speed: 3, catchUp: 0.6 }}
>
  {streamedText}
</TegakiRenderer>`}
          />
        </header>
        <ChatStream client:load />
      </section>

      <section class="chapter" id="ship">
        <header class="chapter-head">
          <span class="chapter-num">06</span>
          <h2>Every <em>framework</em></h2>
          <p>
            One engine with adapters for React, Svelte, Vue, SolidJS, Astro, Web Components and vanilla JS, plus Remotion for video. Eleven fonts
            ship ready to import; the Studio generates bundles from any other font in the browser.
          </p>
        </header>
        <div class="ship" data-fw="react">
          <div class="ship-tabs" role="tablist" aria-label="Framework">
            {
              FRAMEWORKS.map((f, i) => (
                <button type="button" role="tab" data-fw-tab={f.id} aria-selected={i === 0 ? 'true' : 'false'}>
                  {f.label}
                </button>
              ))
            }
          </div>
          <div class="ship-body">
            <div class="ship-code">
              {
                FRAMEWORKS.map((f) => (
                  <div class="ship-pane" data-fw-pane={f.id}>
                    <Code class="code" lang={f.lang as any} themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }} defaultColor={false} code={f.code} />
                  </div>
                ))
              }
            </div>
            <div class="ship-output">
              <span class="ship-output-label">Output</span>
              <Write client:load text="Hello, world!" loop className="ship-output-ink" />
            </div>
          </div>
          <div class="ship-links">
            <a href={`${base}/frameworks/react/`}>Framework guides →</a>
            <a href={`${base}/frameworks/remotion/`}>Render video with Remotion →</a>
            <a href={`${base}/studio/`}>Bring your own font →</a>
          </div>
        </div>
      </section>

      <section class="finale">
        <Finale client:load />
        <div class="cta cta-center">
          <a class="button button-primary" href={`${base}/getting-started/`}>Read the docs</a>
          <a class="button" href="https://github.com/gkurt/tegaki">Star on GitHub</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>MIT licensed · made by <a href="https://twitter.com/gkurttech">@gkurttech</a></span>
      <span class="footer-links">
        <a href={`${base}/getting-started/`}>Docs</a>
        <a href={`${base}/studio/`}>Studio</a>
        <a href={`${base}/demos/videos/`}>Videos</a>
        <a href="https://github.com/gkurt/tegaki">GitHub</a>
        <a href="https://www.npmjs.com/package/tegaki">npm</a>
      </span>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });

      const install = document.querySelector<HTMLButtonElement>('.install');
      install?.addEventListener('click', async () => {
        const state = install.querySelector('.install-state');
        try {
          await navigator.clipboard.writeText(install.dataset.copy ?? '');
          if (state) state.textContent = 'copied';
        } catch {
          if (state) state.textContent = 'press ⌘C';
        }
        setTimeout(() => {
          if (state) state.textContent = 'copy';
        }, 1800);
      });

      const ship = document.querySelector<HTMLElement>('.ship');
      for (const tab of document.querySelectorAll<HTMLButtonElement>('[data-fw-tab]')) {
        tab.addEventListener('click', () => {
          if (!ship) return;
          ship.dataset.fw = tab.dataset.fwTab;
          for (const t of document.querySelectorAll('[data-fw-tab]')) t.setAttribute('aria-selected', String(t === tab));
        });
      }
    </script>
  </body>
</html>
