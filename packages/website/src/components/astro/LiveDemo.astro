---
import type { ComponentProps } from 'astro/types';
import TegakiRenderer from 'tegaki/astro';
import bundle from 'tegaki/fonts/caveat';

interface Props {
  text?: string;
  fontSize?: number;
  time?: any;
  /** Plugins by name: the script below registers the style plugins. */
  plugins?: ComponentProps<typeof TegakiRenderer>['plugins'];
  caption?: string;
}

const { text = 'Hello World', fontSize = 48, time = { mode: 'uncontrolled', speed: 1, loop: true }, plugins, caption } = Astro.props;
---

<div class="not-content live-demo">
  <TegakiRenderer font={bundle} bundle loadFont />
  <div class="live-demo-card">
    <TegakiRenderer
      font={bundle.fullFamily ?? bundle.family}
      {text}
      {time}
      {plugins}
      style={`font-size: ${fontSize}px`}
    />
  </div>
  {caption && <div class="live-demo-caption">{caption}</div>}
</div>

<script>
  import { globalGradientPlugin, glowPlugin, strokeGradientPlugin, TegakiEngine, taperPlugin, wobblePlugin } from 'tegaki/core';

  TegakiEngine.registerPlugin(glowPlugin, taperPlugin, wobblePlugin, strokeGradientPlugin, globalGradientPlugin);
</script>
