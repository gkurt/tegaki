---
interface Props {
  text?: string;
  fontSize?: number;
  /** The element's `plugins` attribute: names, or a JSON array with options. The script below registers the style plugins. */
  plugins?: string;
  caption?: string;
}

const { text = 'Hello World', fontSize = 48, plugins, caption } = Astro.props;
const id = `wc-demo-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="not-content live-demo">
  <div class="live-demo-card">
    <tegaki-renderer id={id} text={text} style={`font-size: ${fontSize}px`} loop plugins={plugins}></tegaki-renderer>
  </div>
  {caption && <div class="live-demo-caption">{caption}</div>}
</div>

<script>
  import {
    globalGradientPlugin,
    glowPlugin,
    registerTegakiElement,
    strokeGradientPlugin,
    TegakiElement,
    TegakiEngine,
    taperPlugin,
    wobblePlugin,
  } from 'tegaki/wc';
  import type { TegakiBundle } from 'tegaki/wc';

  TegakiEngine.registerPlugin(glowPlugin, taperPlugin, wobblePlugin, strokeGradientPlugin, globalGradientPlugin);
  registerTegakiElement();

  let bundlePromise: Promise<TegakiBundle> | null = null;
  function getBundle(): Promise<TegakiBundle> {
    if (!bundlePromise) {
      bundlePromise = import('tegaki/fonts/caveat').then((mod) => (mod as any).default as TegakiBundle);
    }
    return bundlePromise;
  }

  function initDemo(el: TegakiElement) {
    if (el.dataset.initialized != null) return;
    el.dataset.initialized = '';

    getBundle().then((bundle) => {
      el.font = bundle;
    });
  }

  document.querySelectorAll<TegakiElement>('tegaki-renderer[id^="wc-demo-"]').forEach(initDemo);
</script>
